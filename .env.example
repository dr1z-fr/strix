# Connexion Supabase Postgres (utilise idéalement le pooler en prod sur Vercel)
# Direct (dev)        : postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres
# Pooler transaction  : postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:dAZrg2zOrzf4ppbL@db.jpruykrfzkyokjzgxljx.supabase.co:5432/postgres

# Clé HMAC pour signer les jetons de session.
# Générer une nouvelle valeur en prod :  openssl rand -hex 32
SESSION_SECRET=replace-me-with-a-random-32-byte-hex-string

# Discord webhooks (optionnels — laisser vide pour désactiver)
DISCORD_WEBHOOK_OPS=
DISCORD_WEBHOOK_ABSENCES=

# Secret pour authentifier les appels cron Vercel (optionnel mais recommandé)
# Générer :  openssl rand -hex 16
CRON_SECRET=
